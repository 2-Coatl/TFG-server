#!/usr/bin/env bash
# Herramienta Codex reimplementada en Shell.
set -euo pipefail

if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
  echo "[ERROR] Codex requiere Bash 4 o superior." >&2
  exit 2
fi

readonly DELIM=$'\x1f'

declare -gA TASK_DESCRIPTIONS
declare -gA TASK_COMMANDS
declare -gA TASK_DIRECTORIES

trim() {
  local texto="$1"
  texto="${texto%%#*}"
  texto="${texto%%$'\r'}"
  texto="${texto#${texto%%[![:space:]]*}}"
  texto="${texto%${texto##*[![:space:]]}}"
  printf '%s' "$texto"
}

join_delim() {
  local -n _arr=$1
  local resultado=""
  for elemento in "${_arr[@]}"; do
    if [[ -n "$resultado" ]]; then
      resultado+="$DELIM"
    fi
    resultado+="$elemento"
  done
  printf '%s' "$resultado"
}

resolve_path() {
  local base="$1"
  local relativo="$2"
  if command -v realpath >/dev/null 2>&1; then
    (cd "$base" && realpath -m "$relativo")
  elif command -v readlink >/dev/null 2>&1; then
    (cd "$base" && readlink -m "$relativo")
  else
    printf '%s/%s' "$base" "$relativo"
  fi
}

registrar_tarea() {
  local base_dir="$1"
  local nombre="$2"
  local descripcion="$3"
  local comando="$4"
  local directorio="$5"

  if [[ -z "$nombre" ]]; then
    echo "[ERROR] Cada tarea debe tener un nombre." >&2
    exit 2
  fi
  if [[ -z "$comando" ]]; then
    echo "[ERROR] La tarea '$nombre' debe definir un comando." >&2
    exit 2
  fi
  if [[ -n "${TASK_COMMANDS[$nombre]+x}" ]]; then
    echo "[ERROR] La tarea '$nombre' esta declarada mas de una vez." >&2
    exit 2
  fi

  if [[ -z "$directorio" ]]; then
    directorio="."
  fi
  local ruta
  ruta=$(resolve_path "$base_dir" "$directorio")

  TASK_DESCRIPTIONS["$nombre"]="$descripcion"
  TASK_COMMANDS["$nombre"]="$comando"
  TASK_DIRECTORIES["$nombre"]="$ruta"
}

parsear_comando() {
  local linea="$1"
  local contenido="${linea#*=}"
  contenido="${contenido#*[}"
  contenido="${contenido%]*}"

  IFS=',' read -ra partes <<< "$contenido"

  local limpiados=()
  local elemento
  for elemento in "${partes[@]}"; do
    elemento=$(trim "$elemento")
    elemento="${elemento#\"}"
    elemento="${elemento%\"}"
    if [[ -n "$elemento" ]]; then
      limpiados+=("$elemento")
    fi
  done

  if ((${#limpiados[@]} == 0)); then
    echo ""
    return
  fi

  join_delim limpiados
}

cargar_configuracion() {
  local ruta="$1"

  if [[ ! -f "$ruta" ]]; then
    echo "[ERROR] No se encontro el archivo de configuracion en $ruta" >&2
    exit 2
  fi

  local base
  base=$(cd "$(dirname "$ruta")" && pwd)

  local version=""
  local nombre=""
  local descripcion=""
  local comando=""
  local directorio=""
  local dentro_tarea=0

  while IFS= read -r linea || [[ -n "$linea" ]]; do
    linea=$(trim "$linea")
    [[ -z "$linea" ]] && continue

    if [[ "$linea" == "version"* ]]; then
      version="${linea#*=}"
      version=$(trim "$version")
      if [[ "$version" != "1" ]]; then
        echo "[ERROR] La version de configuracion debe ser 1." >&2
        exit 2
      fi
      continue
    fi

    if [[ "$linea" == "[[tareas]]" ]]; then
      if (( dentro_tarea )); then
        registrar_tarea "$base" "$nombre" "$descripcion" "$comando" "$directorio"
      fi
      dentro_tarea=1
      nombre=""
      descripcion=""
      comando=""
      directorio=""
      continue
    fi

    if [[ "$linea" == nombre* ]]; then
      nombre="${linea#*=}"
      nombre=$(trim "$nombre")
      nombre="${nombre#\"}"
      nombre="${nombre%\"}"
      continue
    fi

    if [[ "$linea" == descripcion* ]]; then
      descripcion="${linea#*=}"
      descripcion=$(trim "$descripcion")
      descripcion="${descripcion#\"}"
      descripcion="${descripcion%\"}"
      continue
    fi

    if [[ "$linea" == directorio* ]]; then
      directorio="${linea#*=}"
      directorio=$(trim "$directorio")
      directorio="${directorio#\"}"
      directorio="${directorio%\"}"
      continue
    fi

    if [[ "$linea" == comando* ]]; then
      comando=$(parsear_comando "$linea")
      continue
    fi
  done <"$ruta"

  if (( dentro_tarea )); then
    registrar_tarea "$base" "$nombre" "$descripcion" "$comando" "$directorio"
  fi

  if [[ -z "$version" ]]; then
    echo "[ERROR] La configuracion no declara la version." >&2
    exit 2
  fi
}

listar_tareas() {
  local nombres=()
  for nombre in "${!TASK_COMMANDS[@]}"; do
    nombres+=("$nombre")
  done

  if ((${#nombres[@]} == 0)); then
    echo "[INFO] No hay tareas configuradas."
    return 0
  fi

  IFS=$'\n' read -r -d '' -a nombres_ordenados < <(printf '%s\n' "${nombres[@]}" | sort && printf '\0')
  local nombre descripcion
  for nombre in "${nombres_ordenados[@]}"; do
    descripcion="${TASK_DESCRIPTIONS[$nombre]}"
    if [[ -z "$descripcion" ]]; then
      descripcion="Sin descripcion"
    fi
    echo "[INFO] $nombre: $descripcion"
  done
}

ejecutar_tarea() {
  local objetivo="$1"
  if [[ -z "${TASK_COMMANDS[$objetivo]+x}" ]]; then
    echo "[ERROR] La tarea '$objetivo' no existe en la configuracion." >&2
    return 1
  fi

  local comando_crudo="${TASK_COMMANDS[$objetivo]}"
  IFS="$DELIM" read -r -a comando <<< "$comando_crudo"
  local directorio="${TASK_DIRECTORIES[$objetivo]}"

  echo "[RUNNING] Ejecutando '$objetivo' ..."
  if (cd "$directorio" && "${comando[@]}"); then
    echo "[SUCCESS] La tarea '$objetivo' finalizo correctamente."
    return 0
  else
    local codigo=$?
    echo "[ERROR] La tarea '$objetivo' finalizo con errores (codigo $codigo)." >&2
    return "$codigo"
  fi
}

mostrar_ayuda() {
  cat <<'AYUDA'
Uso: codex [--config RUTA] (listar | ejecutar NOMBRE)

Opciones:
  --config RUTA   Ruta al archivo codex.toml. Usa ./codex.toml por defecto.
AYUDA
}

main() {
  local config=""
  local accion=""
  local tarea=""

  while (($# > 0)); do
    case "$1" in
      --config)
        if (($# < 2)); then
          echo "[ERROR] --config requiere una ruta." >&2
          return 2
        fi
        config="$2"
        shift 2
        ;;
      listar|ejecutar)
        accion="$1"
        shift
        break
        ;;
      --help|-h)
        mostrar_ayuda
        return 0
        ;;
      *)
        echo "[ERROR] Opcion desconocida: $1" >&2
        mostrar_ayuda >&2
        return 2
        ;;
    esac
  done

  if [[ -z "$accion" ]]; then
    echo "[ERROR] Debes indicar una accion: listar o ejecutar." >&2
    mostrar_ayuda >&2
    return 2
  fi

  if [[ "$accion" == "ejecutar" ]]; then
    if (($# == 0)); then
      echo "[ERROR] Debes indicar el nombre de la tarea a ejecutar." >&2
      return 2
    fi
    tarea="$1"
    shift
  fi

  if [[ -z "$config" ]]; then
    config="$(pwd)/codex.toml"
  fi

  cargar_configuracion "$config"

  if [[ "$accion" == "listar" ]]; then
    listar_tareas
    return 0
  fi

  if [[ "$accion" == "ejecutar" ]]; then
    ejecutar_tarea "$tarea"
    return $?
  fi

  echo "[ERROR] Accion desconocida: $accion" >&2
  return 2
}

main "$@"
